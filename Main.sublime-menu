[
	{
		"caption": "Preferences",
		"mnemonic": "n",
		"id": "preferences",
		"children": [
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children": [
					{
						"caption": "PzielinskiMarkdown",
						"children": [
							{
								"caption": "Settings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/PzielinskiMarkdown/PzielinskiMarkdown.sublime-settings",
									"user_file": "${packages}/User/PzielinskiMarkdown.sublime-settings",
									"default": "{}"
								}
							},
							{
								"caption": "Example Key Bindings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/PzielinskiMarkdown/Example.sublime-keymap",
									"user_file": "${packages}/User/Default (${platform}).sublime-keymap"
								}
							}
						]
					}
				]
			}
		]
	}
]
